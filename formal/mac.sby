# SymbiYosys job: unbounded proof (k-induction) that the MAC accumulator never overflows.
# Properties live in the `ifdef FORMAL block of rtl/mac.sv; -DFORMAL keeps them out of sim and lint.

[options]
mode prove
depth 20

[engines]
smtbmc z3

[script]
read -define FORMAL=1
read -sv mac.sv
prep -top mac

[files]
../rtl/mac.sv
